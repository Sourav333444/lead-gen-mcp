# Environment Variables
# Copy this file to .env and fill in your values

# ==========================================
# YouTube Lead Generation
# ==========================================

# YouTube Data API v3 key (required)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Google Sheets ID for lead output (required)
# Get this from the URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEETS_ID=

# Sheet tab name (optional, default: YouTube_Leads)
SHEET_TAB_NAME=YouTube_Leads

# Target number of leads to collect (optional, default: 100)
TARGET_COUNT=100

# Path to service account JSON (optional, for automation)
# If not set, will use OAuth flow with credentials.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# ==========================================
# Copywriting Agent (Anthropic API)
# ==========================================

# Anthropic API key (required for copywriting agent)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model to use (default: claude-opus-4-5-20251101)
# Options: claude-opus-4-5-20251101, claude-sonnet-4-5-20250929
COPYWRITING_MODEL=claude-opus-4-5-20251101

# Max tokens for copy generation (default: 8000)
COPYWRITING_MAX_TOKENS=8000

# Temperature for creativity (0.0-1.0, default: 1.0)
COPYWRITING_TEMPERATURE=1.0

# ==========================================
# General Settings
# ==========================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Note: OAuth credentials go in credentials.json (not here)
# Note: OAuth tokens are stored in token.json (auto-generated)

# ==========================================
# Lead Gen MCP Server
# ==========================================

# Apify — Google Maps scraping
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_...

# Instantly — email campaigns (v2 API key, scope: all:all)
# Get from: https://app.instantly.ai/app/settings/integrations
INSTANTLY_API_KEY=
